{
  "http_server": {
    "ip_listen": "127.0.0.1",
    "port_listen": "3000"
  },
  "api": {
    "base_url": "https://api.uexcorp.space/2.0",
    "endpoints": {
      "prices_all": "/commodities_prices_all",
      "prices_history": "/commodities_prices_history",
      "game_versions": "/game_versions",
      "solar_systems_all": "/star_systems",
      "terminals_all": "/terminals",
      "vehicles": "/vehicles",
      "terminals_distances": "/terminals_distances"
    },
    "timeout": 10000,
    "retries": 3
  },
  "cache": {
    "refresh_interval_minutes": 1,
    "stale_after_minutes": 1440,
    "very_stale_after_minutes": 4320
  },
  "data_files": {
    "max_inventory": "./max_inventory.json",
    "terminal_distances": "./terminals_distances.json"
  },
  "logging": {
    "level": "info",
    "file": "trading.log",
    "console": true
  }
}
